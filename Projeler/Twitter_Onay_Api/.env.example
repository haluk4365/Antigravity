# Twitter_Onay_Api — Environment Variables
# Lokal: bu dosyayı `.env` olarak kopyalayıp doldur.
# Production: Railway servis env'inde tanımla.

# Mail butonundaki imzalı token'ı doğrulamak için ortak gizli anahtar.
# Twitter_Text_Paylasim ile AYNI değer olmalı, yoksa imza eşleşmez.
APPROVAL_SECRET=

# Typefully Pro hesabı API key'i
TYPEFULLY_API_KEY=

# X hesabının Typefully social set ID'si (sayı)
TYPEFULLY_SOCIAL_SET_ID=

# Notion Internal Integration token (sosyal DB'lere erişimli)
NOTION_SOCIAL_TOKEN=
