# =============================================================================
# HLK AI Reklam Asistanı — Ortam Değişkenleri (ÖRNEK)
# =============================================================================
# BU DOSYA GERÇEK SECRET İÇERMEZ. Yalnızca örnek placeholder değerler içerir.
# Gerçek değerler için .env dosyası oluşturun (git tarafından yok sayılır).
# Railway production'da tüm değerler Railway Secrets'tan okunur.
# =============================================================================

# Environment Mode (test = local test bot, production = Railway bot)
ENV=production
TEST_MODE=false

# Telegram Bot Token — Production bot (@hlk_reklam_asistani01_bot)
# BotFather'dan alınır: https://t.me/BotFather
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Telegram Test Bot Token (@hlk01_test_bot) — lokal test modu
TELEGRAM_TOKEN_TEST=your_telegram_test_bot_token_here

# Telegram Admin User ID (sayısal, örn: 123456789)
# Kullanıcı ID'nizi @userinfobot'tan öğrenebilirsiniz
TELEGRAM_ADMIN_USER_ID=your_admin_user_id_here

# Telegram izin verilen kullanıcılar (* = herkes)
TELEGRAM_ALLOWED_USERS=*

# -----------------------------------------------------------------------------
# AI Provider API Anahtarları
# -----------------------------------------------------------------------------

# OpenAI API Key — https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Higgsfield AI API — Video üretimi (https://platform.higgsfield.ai)
HIGGSFIELD_KEY_ID=your_higgsfield_key_id_here
HIGGSFIELD_KEY_SECRET=your_higgsfield_key_secret_here
HIGGSFIELD_API_URL=https://platform.higgsfield.ai

# Kie AI API — Görsel üretimi
KIE_AI_API_KEY=your_kie_ai_api_key_here

# Fal.ai API — Seedance image-to-video (https://fal.ai)
FAL_KEY=your_fal_key_here

# ElevenLabs API — Ses üretimi (https://elevenlabs.io)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Hedra API — Lip-sync video üretimi (https://www.hedra.com)
HEDRA_API_KEY=your_hedra_api_key_here

# Descript API — Video/ses düzenleme ve sentetik ses
DESCRIPT_API_KEY=your_descript_api_key_here

# -----------------------------------------------------------------------------
# Bot Ayarları
# -----------------------------------------------------------------------------
BOT_DEBUG=False
LOG_LEVEL=INFO

# Database (opsiyonel)
DATABASE_URL=sqlite:///data/bot.db

# Telegram file_id cache (ilk /start sonrası otomatik doldurulur)
INTRO_VIDEO_FILE_ID=
